# Copy this to .env and fill in real values. DO NOT commit .env.

# --- LLM (for synthesis) ---
LLM_PROVIDER=gemini          # anthropic | openai | gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Web search provider ---
WEB_SEARCH_PROVIDER=duckduckgo    # tavily | serper | duckduckgo
# TAVILY_API_KEY=             # Optional; check provider's current free quota
# SERPER_API_KEY=             # https://serper.dev — free 2500 req
# (DuckDuckGo needs no key but the duckduckgo-search package must be installed.)

# --- Application settings ---
RESEARCH_LOG_LEVEL=INFO
RESEARCH_CACHE_DIR=.cache/researcher
RESEARCH_CACHE_TTL=3600
RESEARCH_SOURCE_TIMEOUT=20
RESEARCH_SYNTHESIS_TIMEOUT=60
RESEARCH_HTTP_TIMEOUT=8
RESEARCH_ATTEMPTS=3
RESEARCH_BACKOFF=0.5
RESEARCH_CONCURRENCY=3
RESEARCH_RATE_INTERVAL=1
RESEARCH_ARXIV_INTERVAL=3
RESEARCH_MAX_QUESTION_LENGTH=2000
RESEARCH_MAX_RESULTS=3
# Optional ordered fallback, e.g. primary tavily + fallback duckduckgo.
# Leave empty for the Gemini + DuckDuckGo setup (only one key needed).
RESEARCH_WEB_FALLBACKS=
RESEARCH_WEB_PROVIDER_TIMEOUT=6
# Local estimated-token limits. Set according to your account/model quota.
# These conservative application defaults are NOT provider quota claims.
RESEARCH_GEMINI_TPM=60000
RESEARCH_OPENAI_TPM=60000
RESEARCH_ANTHROPIC_TPM=60000
# Alternative key aliases understood by the unchanged AI package:
# GEMINI_API_KEY=
# LLM_API_KEY=
# Unused embedding/vision interfaces in the course package:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# VLM_MODEL=
